# MSDSJ grok-account-manager 本地配置

# DuckMail 服务地址和 API Key
DUCKMAIL_BASE_URL=https://api.duckmail.sbs
DUCKMAIL_API_KEY=

# 可选：DuckMail 域名（默认 @msdsj.cyou，也支持 @msdsj.asia）
DUCKMAIL_DOMAIN=@msdsj.cyou

# 邮箱来源：duckmail、outlook、gmail 或 google
# gmail 表示使用 Gmail 收 x.ai 邮箱验证码；google 表示点击 x.ai 的 Google 账号注册按钮。
GROK_ACCOUNT_MANAGER_EMAIL_SOURCE=duckmail

# Outlook 账号池文件（每行支持：邮箱----密码----clientId----refreshToken----auto/imap/graph 或 邮箱|密码|clientId|refreshToken|auto）
OUTLOOK_ACCOUNTS_FILE=

# Google/Gmail 账号池文件
# gmail 模式：邮箱----应用专用密码 或 邮箱|应用专用密码
# google 模式：邮箱----密码----辅助邮箱(可选) 或 邮箱|密码|辅助邮箱(可选)
GOOGLE_ACCOUNTS_FILE=

# 外部 Sub2API 实例地址（本地部署默认 http://localhost:8080）
SUB2API_BASE_URL=http://localhost:8080

# 在 Sub2API 后台 /admin/settings 生成的 Admin API Key
# 该 Key 通过 x-api-key header 走 admin 路由（参见 sub2api/backend/internal/server/middleware/admin_auth.go）
SUB2API_ADMIN_API_KEY=

# 可选：新建账号默认进入哪些分组（逗号分隔的 group ID）
SUB2API_DEFAULT_GROUP_IDS=

# 本项目账号数据库。默认使用本地 SQLite，账号完整凭证和测试结果都会落库。
GROK_ACCOUNT_MANAGER_DB_PATH=output/grok-account-manager.db

# 注册浏览器最多并发数，以及其中允许同时执行 xAI Device OAuth 的窗口数。
# 注册页面可以多窗口并行；OAuth 默认只并行 2 个，减少同一出口 IP 突发申请/轮询 token。
GROK_ACCOUNT_MANAGER_MAX_CONCURRENCY=20
GROK_ACCOUNT_MANAGER_MAX_OAUTH_CONCURRENCY=2

# 如需后续切 Docker Postgres，可先用 docker-compose.yml 启动数据库；
# 后端切 Postgres 需要再安装对应 Python 驱动。
# DATABASE_URL=postgresql://grok:grok@127.0.0.1:54329/grok_account_manager
