# MSDSJ grok-account-manager 本地配置

# DuckMail 服务地址和 API Key
DUCKMAIL_BASE_URL=https://api.duckmail.sbs
DUCKMAIL_API_KEY=

# 可选：DuckMail 域名（默认 @msdsj.cyou，也支持 @msdsj.asia）
DUCKMAIL_DOMAIN=@msdsj.cyou

# 邮箱来源：duckmail、cloud_mail、outlook、gmail 或 google
# gmail 表示使用 Gmail 收 x.ai 邮箱验证码；google 表示点击 x.ai 的 Google 账号注册按钮。
GROK_ACCOUNT_MANAGER_EMAIL_SOURCE=duckmail

# 可选：注册浏览器代理池文件。每行一个 HOST:PORT 或无认证 http(s) URL。
# 设置后只使用这个文件；留空时 CLI 和本地控制台会合并 ~/Downloads/xx.txt 与控制台已保存节点。
# 文件中的端点会随机领取且同一任务内不复用；代理地址可能包含凭证，请把实际文件保留在本地，不要提交到 Git。
GROK_ACCOUNT_MANAGER_PROXY_FILE=

# 可选：固定出口代理，单个 HOST:PORT 或无认证 http(s) URL。用于本机完全无法直连
# Grok/邮箱服务的部署环境（例如境内服务器需要本地代理落地）。和上面的代理池不同，
# 这个地址每一轮都会重复使用，不会被标记为"已耗尽"；未配置注册代理池时的兜底出口。
GROK_ACCOUNT_MANAGER_EGRESS_PROXY=

# 内置网关使用的宿主机 VPN 代理。默认端口按 Clash/部分代理客户端的混合端口处理。
# 容器内会自动把 127.0.0.1/localhost 改写为 host.docker.internal；也可填写远程
# HTTP/SOCKS5/Trojan/VLESS/SS/VMess 地址。留空则不自动创建本机 VPN 出口节点。
GROK_ACCOUNT_MANAGER_GATEWAY_PROXY=http://127.0.0.1:7890

# Outlook 账号池文件（每行支持：邮箱----密码----clientId----refreshToken----auto/imap/graph 或 邮箱|密码|clientId|refreshToken|auto）
OUTLOOK_ACCOUNTS_FILE=

# Google/Gmail 账号池文件
# gmail 模式：邮箱----应用专用密码 或 邮箱|应用专用密码
# google 模式：邮箱----密码----辅助邮箱(可选) 或 邮箱|密码|辅助邮箱(可选)
GOOGLE_ACCOUNTS_FILE=

# Cloud Mail（maillab/cloud-mail 兼容 API）。地址末尾可带 /api，域名使用逗号分隔。
CLOUD_MAIL_API_BASE=
CLOUD_MAIL_DOMAINS=

# Cloud Mail 认证二选一：优先使用 Public Token；留空时使用登录邮箱和密码。
CLOUD_MAIL_PUBLIC_TOKEN=
CLOUD_MAIL_LOGIN_EMAIL=
CLOUD_MAIL_LOGIN_PASSWORD=

# 外部 Sub2API 实例地址（本地部署默认 http://localhost:8080）
SUB2API_BASE_URL=http://localhost:8080

# 在 Sub2API 后台 /admin/settings 生成的 Admin API Key
# 该 Key 通过 x-api-key header 走 admin 路由（参见 sub2api/backend/internal/server/middleware/admin_auth.go）
SUB2API_ADMIN_API_KEY=

# 可选：新建账号默认进入哪些分组（逗号分隔的 group ID）
SUB2API_DEFAULT_GROUP_IDS=

# 本项目账号数据库。默认使用本地 SQLite，账号完整凭证和测试结果都会落库。
GROK_ACCOUNT_MANAGER_DB_PATH=output/grok-account-manager.db

# 注册浏览器最多并发数，以及其中允许同时执行 xAI Device OAuth 的窗口数。
# 注册页面可以多窗口并行；OAuth 默认只并行 2 个，减少同一出口 IP 突发申请/轮询 token。
GROK_ACCOUNT_MANAGER_MAX_CONCURRENCY=20
GROK_ACCOUNT_MANAGER_MAX_OAUTH_CONCURRENCY=2

# 可选：缩短多轮注册的错峰等待。默认分别为 4-11 秒和 1-3 秒；
# 只建议在代理池充足且能接受更高风控概率时调低。
GROK_ACCOUNT_MANAGER_ROUND_PACING_MIN_SECONDS=4
GROK_ACCOUNT_MANAGER_ROUND_PACING_MAX_SECONDS=11
GROK_ACCOUNT_MANAGER_WORKER_START_STAGGER_MIN_SECONDS=1
GROK_ACCOUNT_MANAGER_WORKER_START_STAGGER_MAX_SECONDS=3

# 单个注册轮次页面失败时的最大尝试数（1-4，默认 3）。
# 每次重试都会重建浏览器并从现有邮箱池领取下一个账号。
GROK_ACCOUNT_MANAGER_MAX_REGISTRATION_ATTEMPTS=3

# 本地中转的网关源码和 Dockerfile 已内置于本仓库的 gateway/ 目录。
# 首次启动会自动构建 grok-account-manager-gateway:local；只需要 Docker Desktop，
# 不需要下载、配置或引用任何外部 grok2api 项目。

# 如需后续切 Docker Postgres，可先用 docker-compose.yml 启动数据库；
# 后端切 Postgres 需要再安装对应 Python 驱动。
# DATABASE_URL=postgresql://grok:grok@127.0.0.1:54329/grok_account_manager
